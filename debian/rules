#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

OVERLAY_FONT ?= /store/git/beepy-symbol-overlay/font.psf

ifneq ($(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))
export CXX := $(DEB_HOST_GNU_TYPE)-g++
export CC  := $(DEB_HOST_GNU_TYPE)-gcc
endif

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cd mobileapp && ./gradlew :libpebble3:jvmFatJar
	$(MAKE) cyberdeck_daemon JAVA_HOME=/usr/lib/jvm/default-java

override_dh_auto_test:

override_dh_shlibdeps:

override_dh_auto_install:
	install -d debian/cyberdeck-service/usr/bin
	install -m 755 cyberdeck_daemon debian/cyberdeck-service/usr/bin/cyberdeck_daemon
	install -d debian/cyberdeck-service/usr/lib/cyberdeck-service
	install -m 644 mobileapp/libpebble3/build/libs/libpebble3-jvm-fat.jar \
		debian/cyberdeck-service/usr/lib/cyberdeck-service/
	install -d debian/cyberdeck-service/usr/share/cyberdeck-service
	install -m 644 $(OVERLAY_FONT) \
		debian/cyberdeck-service/usr/share/cyberdeck-service/overlay-font.psf

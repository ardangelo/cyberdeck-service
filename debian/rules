#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

ifneq ($(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))
export CXX := $(DEB_HOST_GNU_TYPE)-g++
export CC  := $(DEB_HOST_GNU_TYPE)-gcc
endif

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cd mobileapp && ./gradlew --no-daemon --dependency-verification strict \
		:libpebble3:jvmFatJar :libpebble3:verifyJvmDependencyLicenses
	$(MAKE) cyberdeck_daemon JAVA_HOME=$(JAVA_HOME)

override_dh_auto_test:

override_dh_compress:
	dh_compress -Xdependency-licenses/

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	install -d debian/cyberdeck-service/usr/bin
	install -m 755 cyberdeck_daemon debian/cyberdeck-service/usr/bin/cyberdeck_daemon
	install -d debian/cyberdeck-service/usr/lib/cyberdeck-service
	install -m 644 mobileapp/libpebble3/build/libs/libpebble3-jvm-fat.jar \
		debian/cyberdeck-service/usr/lib/cyberdeck-service/
	install -d debian/cyberdeck-service/usr/share/doc/cyberdeck-service/dependency-licenses
	install -m 644 mobileapp/libpebble3/build/reports/dependency-licenses/* \
		debian/cyberdeck-service/usr/share/doc/cyberdeck-service/dependency-licenses/
